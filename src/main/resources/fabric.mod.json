{
  "schemaVersion": 1,
  "id": "vozdacriacao",
  "version": "${version}",
  "name": "La Craft — Voz da Criação",
  "description": "Colete matéria e materialize pedidos no Minecraft.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "br.com.vozdacriacao.VozDaCriacao"
    ],
    "client": [
      "br.com.vozdacriacao.VozCliente"
    ],
    "voicechat": [
      "br.com.vozdacriacao.VozPlugin"
    ],
    "modmenu": [
      "br.com.vozdacriacao.MenuLaCraft"
    ],
    "fabric-gametest": [
      "br.com.vozdacriacao.TesteMundo"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "voicechat": "*"
  },
  "suggests": {
    "modmenu": ">=7.2.2"
  },
  "mixins": [
    "lacraft.mixins.json"
  ]
}